# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Cached market data (regenerated on run; not committed)
data/cache/

# The immutable signal log is YOUR research record and the project's compounding
# asset. It IS versioned now: the daily GitHub Action (.github/workflows/
# daily-signals.yml) appends to it and commits it back, so the repo is the
# persistent store. Only the canonical log is tracked; anything else the signals
# dir accumulates stays ignored. Unlike the cache, this file is not regenerable.
data/signals/*
!data/signals/signals.jsonl

# Batch reports + cron logs (generated by the daily batch job).
#
# `daily.json` is the exception and IS tracked: the scheduled Action generates
# it every run and it is the machine-readable snapshot the dashboard and any
# API consumer can read without replaying the whole signal log. It was being
# written and then thrown away on every run, which is the worst of both — the
# cost of producing it with none of the benefit. Local ad-hoc reports stay
# ignored.
data/reports/*
!data/reports/daily.json

# Trade log (paper + live orders) — your execution record, like the signal log.
# Not regenerable; back it up. Never committed by default.
data/trades/

# Dhan instrument master (symbol -> securityId) for live orders; user-supplied.
data/dhan_instruments.json

# Env and secrets (.env.local is loaded by config.py too — never commit it)
.env
.env.local

# Tooling
.pytest_cache/
.ruff_cache/
.coverage
.DS_Store

# graphify: SHARE the useful outputs (graph.json/graph.html, GRAPH_REPORT.md,
# manifest.json) so collaborators reuse the context. But keep out the parts that
# leak local machine paths (/Users/...) or just churn every run.
graphify-out/cache/
graphify-out/.graphify_*
graphify-out/cost.json

# Derived from the (ignored) signal log by `calibrate`; user-specific
data/calibration.json

# Per-machine source-health diagnostics, rebuilt by `ingest`. Safe to delete.
data/health.json

# Lock directory held by scripts/daily.sh while a run is in flight
data/.daily.lock/

# --- AI tooling, not project code -------------------------------------------
#
# Design/frontend skill packs installed by an assistant, plus generated
# knowledge-graph output. 215 files and 6.6 MB were tracked here, in FOUR
# near-identical copies (.agents/ and agent/ are the same skills in different
# frontmatter formats; data/skills/ was symlinks into .agents/). None of it is
# part of a market-research engine, and a public repo should not ship a
# stranger's clone with a `brandkit` skill in it.
#
# Untracked, not deleted — they still work locally. Delete the directories
# yourself if you want the disk space back.
.agents/
agent/
.claude/
.github/skills/
data/skills/
graphify-out/
skills-lock.json
opencode.json

# Playwright MCP scratch output (screenshots, snapshots)
.playwright-mcp/
